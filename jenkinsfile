pipeline {
    agent any

    environment {
        APP_USERNAME = 'your_username'
        APP_PASSWORD = 'your_password'
    }

    stages {
        stage('Install Dependencies') {
            steps {
                bat 'pip install -r requirements.txt'
            }
        }

        stage('Run Tests') {
            steps {
                bat 'pytest -v'
            }
        }
    }
}